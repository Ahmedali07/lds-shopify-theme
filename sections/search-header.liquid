

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div class="section section--page-width{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
  <div
    class="spacing-style search-page__header"
    style="
      --horizontal-alignment: {{ section.settings.alignment }};
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    {% assign heading_text = 'content.search' | t %}

    {% if search.performed %}
      {% assign heading_text = 'content.search_results' | t %}
    {% endif %}

    {% capture heading_text %}
      <h1 class="search-page__title">{{ heading_text }}</h1>
    {% endcapture %}

    <div class="search-page__heading-row">
      {% content_for 'block', id: 'heading', type: '_heading', text: heading_text %}

      {% if search.performed %}
        <p class="search-page__count">
          {{ 'lds.search.results_count' | t: count: search.results_count, terms: search.terms }}
        </p>
      {% endif %}
    </div>

    {% content_for 'block', id: 'search', type: '_search-input' %}
  </div>
</div>

{% stylesheet %}
  .search-page__header {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: var(--gap-md);
  }

  .search-page__heading-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--gap-sm) var(--gap-lg);
    width: 100%;
  }

  .search-page__heading-row > *,
  .search-page__heading-row .text-block {
    width: auto;
    max-width: 100%;
    flex: 1 1 auto;
  }

  .search-page__title {
    margin: 0;
  }

  .search-page__count {
    flex: 0 0 auto;
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    font-size: var(--font-size-sm, 0.875rem);
  }

  .search-page__header .search-page-input__parent {
    width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.search",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
