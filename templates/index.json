    "custom_liquid_mc9tid": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n  .lds-wholesale-banner {\n    width: 100%;\n    max-width: 1200px;\n    margin: 0 auto;\n    background: #087fb5;\n    border-radius: 8px;\n    overflow: hidden;\n    color: #ffffff;\n  }\n\n  .lds-wholesale-inner {\n    display: grid;\n    grid-template-columns: 1.45fr 0.9fr;\n    min-height: 190px;\n  }\n\n  .lds-wholesale-content {\n    display: flex;\n    align-items: center;\n    gap: 22px;\n    padding: 30px 36px;\n  }\n\n  .lds-wholesale-icon {\n    width: 58px;\n    min-width: 58px;\n    height: 58px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n\n  .lds-wholesale-icon svg {\n    width: 55px;\n    height: 55px;\n    stroke: #ffffff;\n    fill: none;\n    stroke-width: 1.8;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .lds-wholesale-text h2 {\n    margin: 0 0 7px;\n    font-size: 25px;\n    line-height: 1.2;\n    font-weight: 700;\n    letter-spacing: 0.2px;\n    color: #ffffff;\n  }\n\n  .lds-wholesale-text p {\n    margin: 0 0 17px;\n    font-size: 14px;\n    line-height: 1.45;\n    color: #ffffff;\n  }\n\n  .lds-wholesale-buttons {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px;\n  }\n\n  .lds-wholesale-button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-height: 34px;\n    padding: 8px 15px;\n    border-radius: 4px;\n    text-decoration: none;\n    font-size: 12px;\n    font-weight: 600;\n    transition: all 0.2s ease;\n  }\n\n  .lds-wholesale-button.primary {\n    background: #ffffff;\n    color: #087fb5;\n  }\n\n  .lds-wholesale-button.secondary {\n    background: transparent;\n    color: #ffffff;\n    border: 1px solid #ffffff;\n  }\n\n  .lds-wholesale-button:hover {\n    opacity: 0.88;\n    transform: translateY(-1px);\n  }\n\n  .lds-wholesale-image {\n    min-height: 190px;\n    background-image: url(\"IMAGE_URL_ICI\");\n    background-size: cover;\n    background-position: center;\n  }\n\n  @media screen and (max-width: 749px) {\n    .lds-wholesale-inner {\n      grid-template-columns: 1fr;\n    }\n\n    .lds-wholesale-content {\n      padding: 25px 22px;\n      gap: 15px;\n    }\n\n    .lds-wholesale-icon {\n      width: 45px;\n      min-width: 45px;\n      height: 45px;\n    }\n\n    .lds-wholesale-icon svg {\n      width: 43px;\n      height: 43px;\n    }\n\n    .lds-wholesale-text h2 {\n      font-size: 20px;\n    }\n\n    .lds-wholesale-text p {\n      font-size: 13px;\n    }\n\n    .lds-wholesale-image {\n      min-height: 150px;\n    }\n\n    .lds-wholesale-button {\n      font-size: 11px;\n      padding: 8px 12px;\n    }\n  }\n</style>\n\n<div class=\"lds-wholesale-banner\">\n  <div class=\"lds-wholesale-inner\">\n\n    <div class=\"lds-wholesale-content\">\n\n      <div class=\"lds-wholesale-icon\">\n        <svg viewBox=\"0 0 64 64\" aria-hidden=\"true\">\n          <circle cx=\"32\" cy=\"17\" r=\"7\"></circle>\n          <circle cx=\"14\" cy=\"25\" r=\"6\"></circle>\n          <circle cx=\"50\" cy=\"25\" r=\"6\"></circle>\n\n          <path d=\"M20 48c0-9 5-15 12-15s12 6 12 15\"></path>\n          <path d=\"M4 47c0-7 4-12 10-12 5 0 9 4 10 9\"></path>\n          <path d=\"M40 44c1-5 5-9 10-9 6 0 10 5 10 12\"></path>\n        </svg>\n      </div>\n\n      <div class=\"lds-wholesale-text\">\n\n        <h2>VOUS ACHETEZ EN QUANTITÉ ?</h2>\n\n        <p>\n          Découvrez nos offres professionnelles et nos tarifs de gros.\n        </p>\n\n        <div class=\"lds-wholesale-buttons\">\n\n          <a href=\"/pages/vente-en-gros\" class=\"lds-wholesale-button primary\">\n            À PARTIR DE 50 PIÈCES\n          </a>\n\n          <a href=\"/pages/vente-en-gros\" class=\"lds-wholesale-button secondary\">\n            VOIR NOS OFFRES WHOLESALE\n          </a>\n\n        </div>\n\n      </div>\n\n    </div>\n\n    <div class=\"lds-wholesale-image\"></div>\n\n  </div>\n</div>",
        "background_color": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
